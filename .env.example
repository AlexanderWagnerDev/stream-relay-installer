# Copy to .env. Generate two DIFFERENT values with: openssl rand -hex 32
# For existing databases, use their existing API token and panel SECRET_KEY.
LRTMP2_API_TOKEN=
SECRET_KEY=
PANEL_PASSWORD=
PANEL_USERNAME=admin
REQUIRE_LOGIN=True
PANEL_LANG=en
TZ=UTC
LRTMP2_DOMAIN=localhost
LRTMP2_APP=live
RTMP_PORT=1935
RTMP_API_PORT=8090
RTMPPANEL_PORT=8001
SESSION_COOKIE_SECURE=False

# Optional SRTLA profile; get the API key from docker compose logs srtla-server
SLS_API_KEY=
SLS_STATS_PORT=8789
SRTLA_PORT=5000
SRT_PUBLISH_PORT=4001
SRT_PLAYER_PORT=4000
SLSPANEL_PORT=8000
